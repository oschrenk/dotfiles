# vim: filetype=ruby

# Reference
#   see also https://ghostty.org/docs/config/reference
#
# Docs
#   `ghostty +show-config --default --docs | nvim`
#
# Resources:
#   https://github.com/search?q=path%3Aghostty%2Fconfig&type=code

# Window behaviour
#   don't confirm closing/quitting
confirm-close-surface = false
quit-after-last-window-closed = true

# Window Decoration
#   https://ghostty.org/docs/config/reference#window-decoration
# round-corners in macOS
window-decoration = auto
# hide buttons and tabs
macos-titlebar-style = hidden
window-padding-x = 20
window-padding-y = 4
initial-window = true
# hide "shadow"
macos-window-shadow = false

# Font Configuration
#   to list valid fonts `ghostty +list-fonts`
font-size = 24
font-family = "Maple Mono Normal NF"
font-style = "ExtraLight"
font-style-bold = "Regular"
font-style-italic = "ExtraLight Italic"
font-style-bold-italic = "Regular Italic"
font-thicken = true

# Cursor
#   https://ghostty.org/docs/config/reference#cursor-style
cursor-style = block

# Shell
#   https://ghostty.org/docs/config/reference#initial-command
#   https://ghostty.org/docs/config/reference#shell-integration
shell-integration = fish
# Quick terminal sets GHOSTTY_QUICK_TERMINAL=1 in the spawned shell's env;
# branch on it to launch rmpc there. Every other window runs a plain fish.
# tmux-attach-free.sh is off while Ghostty tabs replace tmux sessions:
# command = /run/current-system/sw/bin/fish -c "if set -q GHOSTTY_QUICK_TERMINAL; exec rmpc; else; exec ~/.config/tmux/tmux-attach-free.sh; end"
command = /run/current-system/sw/bin/fish -c "if set -q GHOSTTY_QUICK_TERMINAL; exec rmpc; else; exec /run/current-system/sw/bin/fish -l; end"

# Appearance
#   https://ghostty.org/docs/config/reference#mouse-hide-while-typing
# to list valid themes:
#   ghostty +list-themes
theme = "Gruvbox Dark"
mouse-hide-while-typing = true
# hide the OSC 9;4 progress bar; its color follows the macOS accent color
progress-style = false

# Clipboard
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true

# Quick Terminal
quick-terminal-animation-duration = 0
quick-terminal-autohide = true
quick-terminal-position = center
quick-terminal-screen = mouse
quick-terminal-size = "66%,66%"

##########################
# SPLITS
##########################
split-divider-color=e7dbb6
unfocused-split-fill=000000
unfocused-split-opacity=0.75

##########################
# KEYBOARD
##########################
# https://ghostty.org/docs/config/reference#macos-option-as-alt
macos-option-as-alt = true

# Keybindings
#   https://ghostty.org/docs/config/reference#keybind
#   ghostty +list-keybinds
#   [alt|ctrl|shift|super] + key
#
# tmux-style split keys; performable: passes the key through when no split is in that direction
keybind = performable:ctrl+h=goto_split:left
keybind = performable:ctrl+k=goto_split:up
keybind = performable:ctrl+j=goto_split:down
keybind = performable:ctrl+l=goto_split:right
keybind = ctrl+minus=new_split:down
keybind = ctrl+backslash=new_split:right
keybind = super+n=new_window
keybind = super+up=resize_split:up,10
keybind = super+down=resize_split:down,10
keybind = super+left=resize_split:left,10
keybind = super+right=resize_split:right,10

# vim copy mode; requires the oschrenk/ghostty fork
keybind = ctrl+[=toggle_copy_mode

# visible screen in nvim, opened at the last line (shell prompt only)
keybind = super+shift+y=text:nvim +\x20
keybind = chain=write_screen_file:paste
keybind = chain=text:\r

# reload config
keybind = super+r=reload_config

# open quick terminal
keybind = global:super+grave_accent=toggle_quick_terminal

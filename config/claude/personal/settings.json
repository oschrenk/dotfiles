{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(ekctl add *)",
      "Bash(ekctl alias *)",
      "Bash(ekctl complete *)",
      "Bash(ekctl delete *)",
      "Bash(ekctl free *)",
      "Bash(ekctl list *)",
      "Bash(ekctl next *)",
      "Bash(ekctl show *)",
      "Bash(ekctl today *)",
      "Bash(ekctl tomorrow *)",
      "Bash(ekctl update *)",
      "Bash(plan calendars *)",
      "Bash(plan hours *)",
      "Bash(plan next *)",
      "Bash(plan on *)",
      "Bash(plan today *)",
      "Bash(basename *)",
      "Bash(brew info:*)",
      "Bash(cat *)",
      "Bash(column *)",
      "Bash(comm *)",
      "Bash(cut *)",
      "Bash(date *)",
      "Bash(dirname *)",
      "Bash(docker info *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(git blame *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(go test *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(lightpanda fetch:*)",
      "Bash(ls *)",
      "Bash(nix eval:*)",
      "Bash(nix search:*)",
      "Bash(pbcopy)",
      "Bash(printenv *)",
      "Bash(pwd *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "WebSearch"
    ]
  },
  "model": "opus[1m]",
  "enabledMcpjsonServers": [
    "beeper"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/resolve-infuse-symlinks.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/block-sed-in-place.sh"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/timeout 1 /bin/sh -c 'sketchybar --trigger ai_agent_waiting SESSION_ID=$(tmux display-message -p \"#{session_id}\") WINDOW_ID=$(tmux display-message -p \"#{window_id}\")' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/timeout 1 /bin/sh -c 'sketchybar --trigger ai_agent_done SESSION_ID=$(tmux display-message -p \"#{session_id}\") WINDOW_ID=$(tmux display-message -p \"#{window_id}\")' || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/warn-added-comments.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/timeout 1 /bin/sh -c 'sketchybar --trigger ai_agent_done SESSION_ID=$(tmux display-message -p \"#{session_id}\") WINDOW_ID=$(tmux display-message -p \"#{window_id}\")' || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": false,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "theme": "auto",
  "verbose": false,
  "includePatterns": [
    "**/*"
  ],
  "excludePatterns": [
    ".release/**",
    "build/**",
    "dist/**",
    "node_modules/**",
    "out-tsc/**"
  ]
}

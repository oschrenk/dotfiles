{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(/opt/homebrew/bin/plan calendars *)",
      "Bash(/opt/homebrew/bin/plan hours *)",
      "Bash(/opt/homebrew/bin/plan next *)",
      "Bash(/opt/homebrew/bin/plan on *)",
      "Bash(/opt/homebrew/bin/plan today *)",
      "Bash(/opt/homebrew/bin/reminders add *)",
      "Bash(/opt/homebrew/bin/reminders delete *)",
      "Bash(/opt/homebrew/bin/reminders edit *)",
      "Bash(/opt/homebrew/bin/reminders show *)",
      "Bash(/opt/homebrew/bin/reminders show-all *)",
      "Bash(/opt/homebrew/bin/reminders show-lists *)",
      "Bash(basename *)",
      "Bash(brew info:*)",
      "Bash(cat *)",
      "Bash(column *)",
      "Bash(comm *)",
      "Bash(cut *)",
      "Bash(date *)",
      "Bash(dirname *)",
      "Bash(docker info *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(git blame *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(go test *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(lightpanda fetch:*)",
      "Bash(ls *)",
      "Bash(nix eval:*)",
      "Bash(nix search:*)",
      "Bash(pbcopy)",
      "Bash(printenv *)",
      "Bash(pwd *)",
      "Bash(realpath *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tree *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/oliver/Frameworks/go/bin/claude-compound-allow"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/timeout 1 /bin/sh -c 'sketchybar --trigger ai_agent_waiting SESSION_ID=$(tmux display-message -p \"#{session_id}\") WINDOW_ID=$(tmux display-message -p \"#{window_id}\")' || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/timeout 1 /bin/sh -c 'sketchybar --trigger ai_agent_done SESSION_ID=$(tmux display-message -p \"#{session_id}\") WINDOW_ID=$(tmux display-message -p \"#{window_id}\")' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/timeout 1 /bin/sh -c 'sketchybar --trigger ai_agent_done SESSION_ID=$(tmux display-message -p \"#{session_id}\") WINDOW_ID=$(tmux display-message -p \"#{window_id}\")' || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": false
  },
  "alwaysThinkingEnabled": true,
  "theme": "auto",
  "verbose": false,
  "includePatterns": [
    "**/*"
  ],
  "excludePatterns": [
    ".release/**",
    "build/**",
    "dist/**",
    "node_modules/**",
    "out-tsc/**"
  ],
  "tui": "fullscreen"
}
